# URL base do Redmine (sem barra no final)
REDMINE_URL=https://projetos.ati.pi.gov.br

# API key: Minha conta → Chave de acesso à API
# No modo HTTP também pode enviar Authorization: Bearer <key>
REDMINE_API_KEY=sua_chave_aqui

# Porta do modo HTTP (Grok custom connector + Docker)
PORT=3100

# true = bloqueia POST/PUT/DELETE (demos e dashboards)
REDMINE_READ_ONLY=false
